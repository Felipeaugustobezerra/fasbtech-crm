# Public browser configuration.
# Use distinct project values for local, staging, and production environments.
# The publishable key is intentionally public; never place service_role or secret
# keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only contract delivery configuration.
# Configure these only in the hosting provider's encrypted environment settings.
RESEND_API_KEY=
CONTRACTS_EMAIL_FROM=
